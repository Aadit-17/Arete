# tracker-agentic-app — generated, secret, and machine-local only
# Commit: app/, package.json / lockfiles, .env.example, public/, configs
# Omitted: internal *.md, daily-tracker/, local app/scripts/* except seed-demo.ts

# -----------------------------------------------------------------------------
# Internal docs & planning (keep repo lean for public; README.md kept)
